<resources>
    <style name="Theme.StudioRack" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#080B13</item>
        <item name="android:navigationBarColor">#080B13</item>
    </style>

    <style name="Theme.StudioRack.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080B13</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">#121621</item>
        <item name="postSplashScreenTheme">@style/Theme.StudioRack</item>
    </style>
</resources>
